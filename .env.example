# ZoningFight environment — copy to .env.local (git-ignored) and fill in.
# Required before real letters generate (Gate 3 provisioning).

# ---- Client (Vite, exposed to the browser) --------------------------------
# The anon key is safe to expose: RLS denies direct table access and the client
# only calls the SECURITY DEFINER RPCs in schema.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ---- Server (Vercel functions, NOT exposed) -------------------------------
# Same project URL; the SERVICE key is used only server-side to verify a live
# reservation (zf_verify_reservation) before spending Anthropic tokens.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; leave unset to use the constant in api/_config.js.
# ANTHROPIC_MODEL=claude-opus-5

# Smoke-test bypass key (comma-separated). Defaults to SMOKE-TEST-2026-BAO.
# TEST_KEYS=SMOKE-TEST-2026-BAO

# ---- Setup checklist (Gate 3) ---------------------------------------------
# 1. Create the Supabase project; paste schema.sql into SQL editor -> Run.
# 2. Seed the codes you sell:
#      insert into zf_codes (code) values ('ZF-ABC123') on conflict do nothing;
#    Seed the ONE existing Payhip customer's code so their license still works.
# 3. Set the env vars above in Vercel (and .env.local for local dev).
# 4. Run `npm run verify` with SUPABASE_URL/SUPABASE_SERVICE_KEY set to run the
#    redemption sims against the real project.
